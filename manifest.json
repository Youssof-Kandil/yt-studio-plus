{
  "manifest_version": 3,
  "name": "Studio Plus – Templates, Compare & Video Switcher",
  "short_name": "Studio Plus",
  "version": "1.3.0",
  "description": "Upload templates with series auto-numbering, side-by-side video compare, likes column and a video switcher for YouTube Studio.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://studio.youtube.com/*",
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://studio.youtube.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://studio.youtube.com/*"],
      "js": ["core.js", "panel.js", "templates.js", "likes.js", "compare.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
